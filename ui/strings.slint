// Textos da interface por idioma (i18n). Um struct com todas as frases, uma
// linha por idioma, indexado por Estado.idioma. Trocar de idioma reavalia tudo.
import { Estado } from "estado.slint";

struct Txt {
    params: string,
    secVarreduras: string,
    metodo: string,
    algoritmo: string,
    vertices: string,
    simetria: string,
    tempo: string,
    semLimite: string,
    threads: string,
    backendSat: string,
    verbosidade: string,
    executar: string,
    lblIdioma: string,
    lblTema: string,
    abaInstancias: string,
    abaVarreduras: string,
    viz: string,
    grafo: string,
    log: string,
    vazio: string,
}

export global Textos {
    out property <[Txt]> tabela: [
        // 0 — Português
        {
            params: "PARÂMETROS", secVarreduras: "VARREDURAS",
            metodo: "MÉTODO", algoritmo: "ALGORITMO", vertices: "Número de vértices  n",
            simetria: "Quebra de simetria", tempo: "Tempo limite", semLimite: "sem limite",
            threads: "Paralelismo (threads)", backendSat: "Backend SAT",
            verbosidade: "Verbosidade do log", executar: "Executar",
            lblIdioma: "IDIOMA", lblTema: "TEMA",
            abaInstancias: "Instâncias", abaVarreduras: "Varreduras",
            viz: "VISUALIZAÇÃO", grafo: "grafo em breve",
            log: "LOG DE EXECUÇÃO", vazio: "Configure os parametros e clique em Executar.",
        },
        // 1 — English
        {
            params: "PARAMETERS", secVarreduras: "SWEEP",
            metodo: "METHOD", algoritmo: "ALGORITHM", vertices: "Number of vertices  n",
            simetria: "Symmetry breaking", tempo: "Time limit", semLimite: "no limit",
            threads: "Parallelism (threads)", backendSat: "SAT backend",
            verbosidade: "Log verbosity", executar: "Run",
            lblIdioma: "LANGUAGE", lblTema: "THEME",
            abaInstancias: "Instances", abaVarreduras: "Sweep",
            viz: "VISUALIZATION", grafo: "graph soon",
            log: "EXECUTION LOG", vazio: "Set the parameters and click Run.",
        },
        // 2 — Español
        {
            params: "PARÁMETROS", secVarreduras: "BARRIDOS",
            metodo: "MÉTODO", algoritmo: "ALGORITMO", vertices: "Número de vértices  n",
            simetria: "Ruptura de simetría", tempo: "Límite de tiempo", semLimite: "sin límite",
            threads: "Paralelismo (hilos)", backendSat: "Backend SAT",
            verbosidade: "Verbosidad del registro", executar: "Ejecutar",
            lblIdioma: "IDIOMA", lblTema: "TEMA",
            abaInstancias: "Instancias", abaVarreduras: "Barridos",
            viz: "VISUALIZACIÓN", grafo: "grafo pronto",
            log: "REGISTRO DE EJECUCIÓN", vazio: "Configura los parámetros y haz clic en Ejecutar.",
        },
    ];

    // Linha do idioma atual.
    out property <Txt> x: tabela[Estado.idioma];

    // Listas traduziveis (as opcoes dos dropdowns).
    out property <[string]> metodos:
        Estado.idioma == 1 ? ["Enumeration", "SAT"]
      : Estado.idioma == 2 ? ["Enumeración", "SAT"]
      :                      ["Enumeração", "SAT"];
    out property <[string]> verbosidades:
        Estado.idioma == 1 ? ["Silent", "Normal", "Detailed"]
      : Estado.idioma == 2 ? ["Silenciosa", "Normal", "Detallada"]
      :                      ["Silenciosa", "Normal", "Detalhada"];

    // Algoritmos do metodo ENUMERAÇÃO (2o dropdown quando Metodo = Enumeração).
    out property <[string]> algEnum:
        Estado.idioma == 1 ? ["Labeled naive", "Labeled with pruning and backtracking", "Unlabeled"]
      : Estado.idioma == 2 ? ["Etiquetados ingenuo", "Etiquetados con poda y backtracking", "No etiquetados"]
      :                      ["Rotulados ingênuo", "Rotulados com poda e backtracking", "Não rotulados"];
    // Estrategias do metodo SAT — termos tecnicos, iguais nos tres idiomas.
    out property <[string]> algSat: ["DPLL", "CDCL", "Cube-and-Conquer", "SAT + CAS"];

    // Subtemas (variante de cor) — Terminal/Nord sao nomes proprios; Âmbar traduz.
    out property <[string]> temas:
        Estado.idioma == 1 ? ["Terminal", "Amber (CRT)", "Nord"]
      : Estado.idioma == 2 ? ["Terminal", "Ámbar (CRT)", "Nord"]
      :                      ["Terminal", "Âmbar (CRT)", "Nord"];

    // Rotulos da chave de base (tom geral): indice 0 = escuro, 1 = claro.
    out property <[string]> bases:
        Estado.idioma == 1 ? ["Dark", "Light"]
      : Estado.idioma == 2 ? ["Oscuro", "Claro"]
      :                      ["Escuro", "Claro"];
}
