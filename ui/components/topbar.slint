// Barra superior: abas (Instâncias/Varreduras) à esquerda, seletores à direita.
// As abas sao primitivos (Rectangle+Text+TouchArea) para seguir os 4 temas.
// Os seletores usam ComboBox por ora (viram PopupWindow custom no Passo 5).
import { Tema } from "../theme.slint";
import { Estado } from "../estado.slint";
import { Textos } from "../strings.slint";
import { Dropdown } from "dropdown.slint";
import { Switch } from "switch.slint";

// Uma aba estilo "sublinhado": rotulo em cima, barrinha accent embaixo.
// Empilha os dois com VerticalLayout (irmao vertical do HorizontalLayout).
component Aba inherits Rectangle {
    in property <string> rotulo;
    in property <bool> ativa;
    callback clicado;

    border-radius: 5px;
    // Fundo: aba ativa ganha um veu leve do accent; passar o mouse (has-hover
    // do TouchArea) acende um veu ainda mais leve. with-alpha deixa a cor
    // translucida, entao funciona tanto no tema claro quanto no escuro.
    background: ativa
        ? Tema.accent.with-alpha(0.14)
        : (toque.has-hover ? Tema.accent.with-alpha(0.07) : transparent);

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.rotulo;
            horizontal-alignment: center;
            vertical-alignment: center;
            // texto forte na aba ativa, apagado na inativa.
            color: ativa ? Tema.text : Tema.muted;
            font-size: 11.5px;
            font-weight: 600;
        }
        // Sublinhado: barrinha de 2px que so aparece (accent) na aba ativa.
        Rectangle {
            height: 2px;
            border-radius: 1px;
            background: ativa ? Tema.accent : transparent;
        }
    }
    toque := TouchArea {
        clicked => { root.clicado(); }
    }
}

export component TopBar inherits Rectangle {
    min-height: 46px;
    max-height: 46px;
    background: Tema.topbar;

    HorizontalLayout {
        padding: 9px;
        spacing: 18px;

        // abas (sublinhado) à esquerda — sem caixa em volta
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 6px;
            Aba {
                rotulo: Textos.x.abaInstancias;
                ativa: Estado.aba == 0;
                clicado => { Estado.aba = 0; }
            }
            Aba {
                rotulo: Textos.x.abaVarreduras;
                ativa: Estado.aba == 1;
                clicado => { Estado.aba = 1; }
            }
        }

        // espacador (empurra os seletores para a direita)
        Rectangle { }

        // seletores à direita
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 9px;
            Text {
                text: Textos.x.lblIdioma;
                vertical-alignment: center;
                color: Tema.muted;
                font-size: 11px;
            }
            Dropdown {
                min-width: 128px;
                opcoes: Estado.idiomas;
                indice <=> Estado.idioma;
            }
            Text {
                text: Textos.x.lblTema;
                vertical-alignment: center;
                color: Tema.muted;
                font-size: 11px;
            }
            Dropdown {
                min-width: 128px;
                opcoes: Textos.temas;
                indice <=> Tema.variante;
            }
            // Chave da base (tom geral): escuro <-> claro.
            Text {
                text: Tema.claro ? Textos.bases[1] : Textos.bases[0];
                vertical-alignment: center;
                horizontal-alignment: right;
                min-width: 44px;
                color: Tema.muted;
                font-size: 11px;
            }
            Switch {
                ligado <=> Tema.claro;
            }
        }
    }
}
